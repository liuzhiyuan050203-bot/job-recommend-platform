# 复制为仓库根目录 .env 后按环境修改。scripts/start-all.sh 会读取本文件，且不会覆盖已经导出的变量。
# 不要把真实密钥提交到仓库。下面都是占位或本地开发默认值。

# ---------- Spring Boot ----------
# 生产（--spring.profiles.active=prod）必须设置，且不能等于开发默认值，长度至少 32 字节
JWT_SECRET=please-change-to-a-random-string-at-least-32-bytes
JWT_EXPIRE_HOURS=24

# 数据库。DB_* 给后端；MYSQL_* 给 ai-service。口令请保持一致。
DB_URL=jdbc:mysql://127.0.0.1:3306/job_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=job
DB_PASSWORD=job123
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=job_platform

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=job_platform
MYSQL_USER=job
MYSQL_PASSWORD=job123

# 后端调用 ai-service 的共享令牌，两边必须相同（后端 fastapi.internal-token / ai-service AI_INTERNAL_TOKEN）
AI_INTERNAL_TOKEN=change-me-internal-token
AI_BASE_URL=http://127.0.0.1:8000

# 简历原件目录。留空则使用进程工作目录下的 data/uploads
UPLOAD_DIR=

# ---------- 大模型（ai-service）----------
# LLM_PROVIDER: ollama | gemini | openai | offline
# 默认本地 Ollama。切换云端时改 provider、model、key，openai 还可设 LLM_BASE_URL。
# 改完后重启 ai-service（本机 systemd 为 bishe-ai）。不要填写真实密钥。
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800
LLM_TIMEOUT=120
LLM_TOOL_CALLING=auto

# ---- 批任务与在线问答的资源隔离（见 experiments/stability/README.md）----
# local[*] 实际只用 min(SPARK_LOCAL_CORES, 逻辑核数) 个核，给大模型推理留出 CPU；0 = 不限制
SPARK_LOCAL_CORES=4
# 推荐/分析批次在独立子进程中运行（崩溃不拖垮 ai-service，可超时终止）；false 则在服务进程内线程中运行
SPARK_BATCH_ISOLATED=true
# 批次子进程（含 Spark JVM）的 nice 值，0 = 不降低优先级
SPARK_BATCH_NICE=10
# 运行中时最多再排队的批次数，超出返回 409；同一任务组合重复提交会合并到已排队的批次
SPARK_BATCH_QUEUE_MAX=2
# 单个批次的最长运行秒数，超时终止并记为失败
SPARK_BATCH_TIMEOUT=1800
# 首个 token 等待上限（秒）与整轮回答截止（秒），超时改用知识库摘录/工具结果作答并带引用
LLM_FIRST_TOKEN_TIMEOUT=45
LLM_ANSWER_DEADLINE=90
# 提示词预算：0 表示按提供方自动（本地小模型保持 300/1500，云端更大）
RAG_PROMPT_CHUNK_CHARS=0
RAG_PROMPT_CHAR_BUDGET=0
# 近域拒答（考研/护照等）：默认开启。门槛在 dev 集标定（questions_scope.jsonl），held-out 报告。
RAG_SCOPE_GATE=true
RAG_SCOPE_OUT_COSINE=0.82
RAG_SCOPE_UNKNOWN_COSINE=0.62
