# ==========================================
# 高校就业推荐平台 AI 算法与智能体服务环境变量配置示例
# ==========================================

# 应用基础配置
APP_NAME=ai-service
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# MySQL 8.4 数据库连接配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=job_platform
MYSQL_USER=job
MYSQL_PASSWORD=job123

# Chroma 向量数据库本地持久化目录 (相对 ai-service 目录解析)
CHROMA_DIR=./data/chroma

# 跨域配置 (支持 Spring Boot 8080 与 Vue 前端 5173)
# 可采用逗号分隔格式，或 JSON 数组格式
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# ==========================================
# 内部通信安全令牌 (与 Spring Boot 后端交互共享凭证)
# ==========================================
AI_INTERNAL_TOKEN=change-me-internal-token

# ==========================================
# 向量嵌入模型配置 (FastEmbed)
# ==========================================
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_CACHE_DIR=./data/models

# ==========================================
# 大语言模型配置 (LLM Infrastructure)
# ==========================================

# LLM_PROVIDER 可选：ollama | gemini | openai | offline
# openai 可接任意 OpenAI 兼容端点（DeepSeek / 通义 / OpenRouter 等）。
# 旧值 openai_compatible 仍可用。改完后重启 ai-service（本机 systemd 为 bishe-ai）。
# 不要填写真实密钥。

# 1. 默认配置: 本地 Ollama (qwen2.5:3b)，开发与测试用，行为与原来一致
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800
LLM_TIMEOUT=120
LLM_TOOL_CALLING=auto

# ---- 批任务与在线问答的资源隔离（见 experiments/stability/README.md）----
# local[*] 实际只用 min(SPARK_LOCAL_CORES, 逻辑核数) 个核，给大模型推理留出 CPU；0 = 不限制
SPARK_LOCAL_CORES=4
# 推荐/分析批次在独立子进程中运行（崩溃不拖垮 ai-service，可超时终止）；false 则在服务进程内线程中运行
SPARK_BATCH_ISOLATED=true
# 批次子进程（含 Spark JVM）的 nice 值，0 = 不降低优先级
SPARK_BATCH_NICE=10
# 运行中时最多再排队的批次数，超出返回 409；同一任务组合重复提交会合并到已排队的批次
SPARK_BATCH_QUEUE_MAX=2
# 单个批次的最长运行秒数，超时终止并记为失败
SPARK_BATCH_TIMEOUT=1800
# 首个 token 等待上限（秒）与整轮回答截止（秒），超时改用知识库摘录/工具结果作答并带引用
LLM_FIRST_TOKEN_TIMEOUT=45
LLM_ANSWER_DEADLINE=90

# RAG：余弦相似度低于阈值的切片不会进入回答
RAG_SCORE_THRESHOLD=0.50
RAG_TOP_K=4
RAG_COLLECTION=job_knowledge
# dense | bm25 | hybrid | hybrid_rerank
RAG_RETRIEVAL_MODE=hybrid

# 2. 备选配置示例: Google Gemini（在 Google AI Studio 按量开通，填写 LLM_API_KEY）
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=your-gemini-api-key
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=800
# LLM_TIMEOUT=120
# LLM_TOOL_CALLING=auto
# LLM_BASE_URL 可留空（不要沿用本机 11434）

# 3. 备选配置示例: OpenAI 官方
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-your-openai-api-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=800
# LLM_TIMEOUT=120
# LLM_TOOL_CALLING=auto

# 4. 备选配置示例: DeepSeek / 通义 / OpenRouter 等 OpenAI 兼容接口
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-your-deepseek-api-key
# LLM_MODEL=deepseek-chat
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=800
# LLM_TIMEOUT=120
# LLM_TOOL_CALLING=auto
#
# 通义百炼兼容模式：
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-your-dashscope-api-key
# LLM_MODEL=qwen-plus
#
# OpenRouter：
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-your-openrouter-api-key
# LLM_MODEL=openai/gpt-4o-mini

# 5. 备选配置示例: 纯离线抽取模式 (不请求任何外部大模型，由 OfflineGenerator 执行字符 2-gram 抽取)
# LLM_PROVIDER=offline
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=offline
# LLM_MODEL=offline
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=800
# LLM_TIMEOUT=10
# LLM_TOOL_CALLING=false
