# ==========================================
# 高校就业推荐平台 AI 算法与智能体服务环境变量配置示例
# ==========================================

# 应用基础配置
APP_NAME=ai-service
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# MariaDB / MySQL 数据库连接配置 (兼容 MySQL 协议)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=job_platform
MYSQL_USER=job
MYSQL_PASSWORD=job123

# Chroma 向量数据库本地持久化目录 (相对 ai-service 目录解析)
CHROMA_DIR=./data/chroma

# 跨域配置 (支持 Spring Boot 8080 与 Vue 前端 5173)
# 可采用逗号分隔格式，或 JSON 数组格式
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# ==========================================
# 内部通信安全令牌 (与 Spring Boot 后端交互共享凭证)
# ==========================================
AI_INTERNAL_TOKEN=change-me-internal-token

# ==========================================
# 向量嵌入模型配置 (FastEmbed)
# ==========================================
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_CACHE_DIR=./data/models

# ==========================================
# 大语言模型配置 (LLM Infrastructure)
# ==========================================

# 1. 默认配置: 本地部署 Ollama (qwen2.5:3b)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800
LLM_TIMEOUT=120
LLM_TOOL_CALLING=auto

# 2. 备选配置示例: DeepSeek API
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-your-deepseek-api-key
# LLM_MODEL=deepseek-chat
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=800
# LLM_TIMEOUT=120
# LLM_TOOL_CALLING=auto

# 3. 备选配置示例: 阿里云百炼 通义千问 (DashScope 兼容模式)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-your-dashscope-api-key
# LLM_MODEL=qwen-plus
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=800
# LLM_TIMEOUT=120
# LLM_TOOL_CALLING=auto

# 4. 备选配置示例: 智谱清言 BigModel (Zhipu AI)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# LLM_API_KEY=your-zhipu-api-key
# LLM_MODEL=glm-4-flash
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=800
# LLM_TIMEOUT=120
# LLM_TOOL_CALLING=auto

# 5. 备选配置示例: 纯离线抽取模式 (不请求任何外部大模型，由 OfflineGenerator 执行字符 2-gram 抽取)
# LLM_PROVIDER=offline
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=offline
# LLM_MODEL=offline
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=800
# LLM_TIMEOUT=10
# LLM_TOOL_CALLING=false
