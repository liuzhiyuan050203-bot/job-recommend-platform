#!/bin/sh
### BEGIN INIT INFO
# Provides:          mysql8
# Required-Start:    $local_fs $network $remote_fs
# Required-Stop:     $local_fs $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: MySQL 8.4 LTS (job_platform)
### END INIT INFO
# 安装：sudo cp db/mysql8/mysql8.init /etc/init.d/mysql8 && sudo update-rc.d mysql8 defaults
BASEDIR=/opt/mysql
CNF=/etc/mysql8/my.cnf
RUNDIR=/run/mysqld8
PIDFILE=$RUNDIR/mysqld.pid

ping() { "$BASEDIR/bin/mysqladmin" --defaults-file="$CNF" --protocol=socket -uroot ping >/dev/null 2>&1 || "$BASEDIR/bin/mysqladmin" --protocol=tcp -h127.0.0.1 -P3306 -ujob -pjob123 ping >/dev/null 2>&1; }

case "$1" in
  start)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then echo "MySQL 8 already running."; exit 0; fi
    mkdir -p "$RUNDIR" /var/log/mysql8 && chown mysql:mysql "$RUNDIR" /var/log/mysql8
    echo "Starting MySQL 8.4 ..."
    cd "$BASEDIR" && nohup "$BASEDIR/bin/mysqld_safe" --defaults-file="$CNF" >/dev/null 2>&1 &
    i=0; while [ $i -lt 60 ]; do
      [ -S "$RUNDIR/mysqld.sock" ] && [ -f "$PIDFILE" ] && { echo "MySQL 8 started (pid $(cat "$PIDFILE"))."; exit 0; }
      sleep 0.5; i=$((i+1)); done
    echo "MySQL 8 failed to start; see /var/log/mysql8/error.log" >&2; exit 1 ;;
  stop)
    if [ ! -f "$PIDFILE" ]; then echo "MySQL 8 not running."; exit 0; fi
    pid=$(cat "$PIDFILE"); echo "Stopping MySQL 8 (pid $pid) ..."
    kill "$pid" 2>/dev/null
    i=0; while kill -0 "$pid" 2>/dev/null && [ $i -lt 120 ]; do sleep 0.5; i=$((i+1)); done
    kill -0 "$pid" 2>/dev/null && { echo "MySQL 8 did not stop" >&2; exit 1; }
    echo "MySQL 8 stopped." ;;
  restart) "$0" stop && "$0" start ;;
  status)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then echo "MySQL 8 is running (pid $(cat "$PIDFILE"))."; else echo "MySQL 8 is not running."; exit 3; fi ;;
  *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
