# MySQL 8.4 LTS 服务端配置（本项目演示环境）。
# 安装位置：/opt/mysql -> /opt/mysql-8.4.13（官方 Linux Generic 二进制包），配置复制到 /etc/mysql8/my.cnf。
# 启动时用 --defaults-file 指定本文件，避免读到 MariaDB 留下的 /etc/mysql/my.cnf。
[mysqld]
user                    = mysql
basedir                 = /opt/mysql
datadir                 = /var/lib/mysql8
socket                  = /run/mysqld8/mysqld.sock
pid-file                = /run/mysqld8/mysqld.pid
log-error               = /var/log/mysql8/error.log
bind-address            = 127.0.0.1
port                    = 3306
mysqlx                  = OFF
character-set-server    = utf8mb4
collation-server        = utf8mb4_unicode_ci
default-time-zone       = '+08:00'
max_connections         = 200
innodb_buffer_pool_size = 512M
skip-name-resolve
# 二进制日志对单机演示无用，关掉以省磁盘
disable-log-bin

[client]
port                    = 3306
socket                  = /run/mysqld8/mysqld.sock
default-character-set   = utf8mb4
